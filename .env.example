APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

HUBSPOT_CLIENT_SECRET=
HUBSPOT_REQUEST_LOGGING=false
HUBSPOT_TEST_MODE=true
HUBSPOT_PORTAL_TENANTS='{}'
HUBSPOT_ALLOWED_ORIGINS="https://*.hubspot.com,https://hubspot.com"
# HubSpot CRM REST
HUBSPOT_CRM_BASE_URL=https://api.hubapi.com
HUBSPOT_CRM_TIMEOUT=15
HUBSPOT_CRM_RETRY_TIMES=3
HUBSPOT_CRM_RETRY_SLEEP_MS=100
HUBSPOT_CRM_BATCH_SIZE=100
HUBSPOT_CRM_LINE_ITEM_SKU_PROPERTY=hs_sku
HUBSPOT_CRM_LINE_ITEM_QUANTITY_PROPERTY=quantity
# JSON map of tenant_id => HubSpot Service Key, e.g. {"tenant-test":"pat-na1-..."}
HUBSPOT_SERVICE_KEYS='{}'
# Callback completion uses the tenant-scoped HubSpot Service Key above.
HUBSPOT_CALLBACK_BASE_URL=https://api.hubapi.com
HUBSPOT_CALLBACK_API_VERSION=2026-03
HUBSPOT_CALLBACK_TIMEOUT=10
HUBSPOT_NOTE_DEAL_ASSOCIATION_TYPE_ID=214
# OpenRouter API key and model(s) for AI features
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct,qwen/qwen3-coder-30b-a3b-instruct
OPENROUTER_SMART_MODELS=qwen/qwen3.7-flash,google/gemma-3-12b-it
HUBSPOT_AI_TIMEOUT=15
HUBSPOT_AI_SMART_TIMEOUT=60
HUBSPOT_LOG_LEVEL=debug
HUBSPOT_APP_ID_HSSQ=
AI_LOG_LEVEL=debug

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
